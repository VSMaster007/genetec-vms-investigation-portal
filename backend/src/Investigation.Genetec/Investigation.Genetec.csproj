<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Investigation.Application\Investigation.Application.csproj" />
    <ProjectReference Include="..\Investigation.Domain\Investigation.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(GSC_SDK_CORE)' != ''">$(DefineConstants);GENETEC_PLATFORM_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(GSC_SDK_CORE)' != ''">
    <Reference Include="Genetec.Sdk">
      <HintPath>$(GSC_SDK_CORE)/Genetec.Sdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
